// 背景图片
body
  background: url(/images/background-future.jpg)
  background-repeat: no-repeat
  background-attachment: fixed
  background-size: cover
  background-position: 50% 50%

// 博客内容透明化
.content-wrap
  opacity: 0.9

.sidebar
  opacity: 0.9

.header-inner
  background: rgba(255, 255, 255, 0.8)

.popup
  opacity: 0.9

:root
  --content-bg-color: rgba(255, 255, 255, 0.9)

// 深色/浅色模式切换按钮
#darkmode-toggle
  position: fixed
  bottom: 100px
  right: 30px
  z-index: 9999
  cursor: pointer
  font-size: 24px
  width: 40px
  height: 40px
  line-height: 40px
  text-align: center
  border-radius: 50%
  background: rgba(0, 0, 0, 0.3)
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3)
  transition: all 0.3s ease
  user-select: none
  &:hover
    background: rgba(0, 0, 0, 0.5)
    transform: scale(1.1)

// 浅色模式强制覆盖
[data-color-scheme="light"]
  color-scheme: light
  --body-bg-color: #f5f7f9
  --content-bg-color: rgba(255, 255, 255, 0.9)
  --text-color: #555
  --link-color: #555
  --link-hover-color: #222
  --brand-color: #fff
  --brand-hover-color: #fff

  .header-inner
    background: rgba(255, 255, 255, 0.8)

// 深色模式强制覆盖
[data-color-scheme="dark"]
  color-scheme: dark
  --body-bg-color: #282828
  --content-bg-color: rgba(34, 34, 34, 0.9)
  --text-color: #ccc
  --link-color: #ccc
  --link-hover-color: #eee
  --brand-color: #222
  --brand-hover-color: #222

  .header-inner
    background: rgba(34, 34, 34, 0.8)
